#!/bin/bash

# omarchy:summary=Launch or focus on a given web app identified by the window-pattern.
# omarchy:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: omarchy-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
url="$1"
LAUNCH_COMMAND="omarchy-launch-webapp $@"

# Chromium --app windows carry the URL's host in their window class, e.g.
# chrome-web.whatsapp.com__-Default, while the first argument is only the
# binding's display name. Matching the host against the class alone keeps an
# ordinary browser window whose active tab title contains that name from being
# taken for the web app and focused instead of launching it.
host_pattern=""
if [[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*://([^/?#]+) ]]; then
  host=${BASH_REMATCH[1]}
  host=${host##*@}
  host=${host%%:*}
  host=${host//./\\.}
  [[ -n $host ]] && host_pattern="-${host}"
fi

if [[ -n $host_pattern ]]; then
  exec omarchy-launch-or-focus --class "$host_pattern" "$LAUNCH_COMMAND"
else
  # A first argument that is not a URL keeps its historical meaning: match the
  # pattern a hand-written caller supplied.
  exec omarchy-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
fi
